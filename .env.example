# ---- Telegram ----
# Lấy từ @BotFather sau khi tạo bot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# chat_id của 2 group (số âm, ví dụ -1001234567890)
RSI_CHAT_ID=-1001234567890
BANK_TECH_CHAT_ID=-1000987654321

# ---- Chế độ ----
# console = chỉ in ra màn hình (để test) | telegram = gửi thật
NOTIFIER=console
# 1 = không ghi trạng thái, dùng khi thử nghiệm
DRY_RUN=0
# 1 = cho phép quét thứ 7 + chạy ngay khi serve khởi động (chỉ để test)
TEST_WEEKEND=0

# ---- Ngưỡng chỉ báo ----
RSI_PERIOD=14
RSI_OVERSOLD=30
BB_PERIOD=20
BB_STD=2
MA_PERIOD=50
BOUNCE_EXPIRY_DAYS=5

# ---- Nguồn dữ liệu ----
VNSTOCK_SOURCE=VCI

# API key vnstock. Đăng ký miễn phí tại https://vnstocks.com/login
# BẮT BUỘC nếu muốn đặt MAX_RPM > 18.
#   Để trống  -> gói Guest, trần 20 req/phút  -> đặt MAX_RPM=18
#   Có key    -> gói Cộng đồng, trần 60/phút  -> đặt MAX_RPM=55
VNSTOCK_API_KEY=

# MAX_RPM là bộ giới hạn PHÍA BOT, nó KHÔNG nâng quota.
# Đặt cao hơn trần thật = bot tự đâm vào rate limit và bị giết tiến trình.
MAX_RPM=18

# Chặn vnstock tự ghi file AGENTS.md vào thư mục project
VNSTOCK_DISABLE_AGENT_SETUP=1

# ---- Khác ----
DB_PATH=data/bot.sqlite
INTRADAY_SCAN_MINUTES=30

# ---- Slack (chỉ cần khi NOTIFIER=slack) ----
SLACK_RSI_WEBHOOK=https://hooks.slack.com/services/T000/B000/xxxx
SLACK_BANK_WEBHOOK=https://hooks.slack.com/services/T000/B111/yyyy
